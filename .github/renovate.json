{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Update stylelint and its standard config together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["stylelint", "stylelint-config-standard"],
      "groupName": "stylelint"
    }
  ]
}
